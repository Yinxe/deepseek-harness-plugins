{
  "name": "deepseek-harness-plugins",
  "version": "0.1.0",
  "description": "deepseek-harness-plugins - TypeScript plugin harness",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "oxlint . --deny-warnings",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format",
    "dev": "pnpm --filter @dshp/vision-bridge dev"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yinxe/deepseek-harness-plugins.git"
  },
  "private": true
}
