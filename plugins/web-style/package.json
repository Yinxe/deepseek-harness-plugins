{
  "name": "@dshp/web-style",
  "version": "0.1.0",
  "description": "DeepSeek Harness (DSH) web style suite: 23-theme gallery with one-click switching, persisted theme selection, global radius tuning, and Material You wallpaper color extraction — all rendered over the official light/dark token layer. 样式套件：23 套主题画廊一键切换、主题选择持久化、全局圆角调节与 Material You 壁纸取色——全部叠加渲染在官方亮/暗 token 层之上。",
  "license": "MIT",
  "author": "Yinxe",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "theme",
    "design-system",
    "material-you",
    "md3"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf lib *.tsbuildinfo",
    "test": "node --check lib/host.js && node --check lib/client.js && node scripts/check-themes.mjs && echo \"syntax ok\"",
    "prepublishOnly": "pnpm typecheck && pnpm build",
    "lint": "oxlint --deny-warnings --config ../../.oxlintrc.json src tsup.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yinxe/deepseek-harness-plugins.git",
    "directory": "plugins/web-style"
  },
  "bugs": {
    "url": "https://github.com/Yinxe/deepseek-harness-plugins/issues"
  },
  "homepage": "https://github.com/Yinxe/deepseek-harness-plugins/tree/main/plugins/web-style#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tsup": "^8.5.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dependencies": {}
}
