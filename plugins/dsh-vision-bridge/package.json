{
  "name": "@dshp-inx/vision-bridge",
  "version": "1.3.2",
  "description": "DeepSeek Harness (DSH) vision bridge: let text-only models delegate image understanding to multimodal vision models via vision_describe tool, with persistent settings UI and primary/fallback auto-retry.",
  "license": "MIT",
  "author": "Yinxe",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "vision",
    "multimodal",
    "image",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "node --check dist/index.js && echo \"syntax ok\"",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yinxe/deepseek-harness-plugins.git",
    "directory": "plugins/dsh-vision-bridge"
  },
  "bugs": {
    "url": "https://github.com/Yinxe/deepseek-harness-plugins/issues"
  },
  "homepage": "https://github.com/Yinxe/deepseek-harness-plugins/tree/main/plugins/dsh-vision-bridge#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
